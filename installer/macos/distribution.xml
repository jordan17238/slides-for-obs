<?xml version="1.0" encoding="utf-8"?>
<!--
  productbuild distribution for the "Slides for OBS" macOS installer.

  Produces SlidesForOBS.pkg, which installs the plugin bundle into the
  system-wide OBS plugin directory:

      /Library/Application Support/obs-studio/plugins/

  Installing system-wide (rather than into ~/Library) means the plugin works
  for every user account on the machine, and it is where other OBS plugin
  installers put themselves. It needs an administrator password, which the
  macOS Installer prompts for.

  Re-running the installer over an existing install simply replaces the
  bundle, so this doubles as the updater — same as the Windows installer.

  Prerequisites (LibreOffice, and poppler for pdftoppm) are stated in the
  welcome and conclusion panes rather than enforced: they can legitimately be
  installed after the plugin, and blocking the install would be unhelpful.
-->
<installer-gui-script minSpecVersion="2">
    <title>Slides for OBS</title>

    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <!-- No per-component customisation: there is only one thing to install. -->
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>

    <choices-outline>
        <line choice="default">
            <line choice="plugin"/>
        </line>
    </choices-outline>

    <choice id="default"/>
    <choice id="plugin" visible="false">
        <pkg-ref id="com.jordanhunter.slides-for-obs"/>
    </choice>

    <pkg-ref id="com.jordanhunter.slides-for-obs" onConclusion="none">plugin.pkg</pkg-ref>
</installer-gui-script>
